{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cia/task.schema.json",
  "title": "Change impact task manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "source_name", "source_url", "repository_url", "issue_url",
    "issue_text", "issue_text_source", "issue_created_at", "target_sha", "parent_sha",
    "changed_paths", "selection_decision"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "repository_url": {"type": "string", "format": "uri"},
    "issue_url": {"type": "string", "format": "uri"},
    "issue_text": {"type": "string", "minLength": 1},
    "issue_text_source": {"type": "string", "minLength": 1},
    "issue_created_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "parent_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selection_decision": {"type": "string", "minLength": 1},
    "cleaning_decisions": {"type": "array", "items": {"type": "string"}},
    "suitability_notes": {"type": "array", "items": {"type": "string"}}
  }
}

